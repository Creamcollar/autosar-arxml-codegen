          <PARAMETER-VALUES>
            <ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiChannelId</SHORT-NAME>
              <VALUE>0</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiChannelType</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiDataWidth</SHORT-NAME>
              <VALUE>8</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiDefaultData</SHORT-NAME>
              <VALUE>0</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiEbMaxLength</SHORT-NAME>
