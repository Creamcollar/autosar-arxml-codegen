          <PARAMETER-VALUES>
            <ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiMaxHwUnit</SHORT-NAME>
              <VALUE>0</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE>
      </ELEMENTS>
