<?xml version='1.0' encoding='utf-8'?>
<AUTOSAR>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>SpiPackage</SHORT-NAME>
      <ELEMENTS>
        <ECUC-CONTAINER-VALUE>
          <SHORT-NAME>SpiConfigSet</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Spi/SpiConfigSet</DEFINITION-REF>
          <PARAMETER-VALUES>
            <ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiConfigSetIncluded</SHORT-NAME>
              <VALUE>true</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE><ECUC-CONTAINER-VALUE>
          <SHORT-NAME>SpiDemEventParameterRefs</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Spi/SpiDemEventParameterRefs</DEFINITION-REF>
          <PARAMETER-VALUES>
            <ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SPI_E_HARDWARE_ERROR</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE><ECUC-CONTAINER-VALUE>
          <SHORT-NAME>SpiGeneral</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Spi/SpiGeneral</DEFINITION-REF>
          <PARAMETER-VALUES>
            <ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiCancelApi</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiChannelBuffersAllowed</SHORT-NAME>
              <VALUE>1</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiDevErrorDetect</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiHwStatusApi</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiInterruptibleSeqAllowed</SHORT-NAME>
              <VALUE>False</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiLevelDelivered</SHORT-NAME>
              <VALUE>0</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiMainFunctionPeriod</SHORT-NAME>
              <VALUE>10</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiSupportConcurrentSyncTransmit</SHORT-NAME>
              <VALUE>False</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiUserCallbackHeaderFile</SHORT-NAME>
              <VALUE />
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiVersionInfoApi</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE><ECUC-CONTAINER-VALUE>
          <SHORT-NAME>SpiSequence</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Spi/SpiSequence</DEFINITION-REF>
          <PARAMETER-VALUES>
            <ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiInterruptibleSequence</SHORT-NAME>
              <VALUE>False</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiSeqEndNotification</SHORT-NAME>
              <VALUE>False</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiSequenceId</SHORT-NAME>
              <VALUE>0</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiJobAssignment</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE><ECUC-CONTAINER-VALUE>
