            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiIbNBuffers</SHORT-NAME>
              <VALUE>1</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiTransferStart</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE><ECUC-CONTAINER-VALUE>
          <SHORT-NAME>SpiChannelList</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Spi/SpiChannelList</DEFINITION-REF>
          <PARAMETER-VALUES>
            <ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiChannelIndex</SHORT-NAME>
              <VALUE>0</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiChannelAssignment</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE><ECUC-CONTAINER-VALUE>
          <SHORT-NAME>SpiJob</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Spi/SpiJob</DEFINITION-REF>
          <PARAMETER-VALUES>
            <ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiHwUnitSynchronous</SHORT-NAME>
              <VALUE>SYNCHRONOUS</VALUE>
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiJobEndNotification</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiJobId</SHORT-NAME>
              <VALUE>0</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiJobPriority</SHORT-NAME>
              <VALUE>0</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiDeviceAssignment</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE><ECUC-CONTAINER-VALUE>
          <SHORT-NAME>SpiExternalDevice</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Spi/SpiExternalDevice</DEFINITION-REF>
          <PARAMETER-VALUES>
            <ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiBaudrate</SHORT-NAME>
              <VALUE>1000000</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiCsBehavior</SHORT-NAME>
              <VALUE>CS_KEEP_ASSERTED</VALUE>
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiCsIdentifier</SHORT-NAME>
              <VALUE>CS0</VALUE>
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiCsPolarity</SHORT-NAME>
              <VALUE>HIGH</VALUE>
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiCsSelection</SHORT-NAME>
              <VALUE>CS_VIA_GPIO</VALUE>
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiDataShiftEdge</SHORT-NAME>
              <VALUE>LEADING</VALUE>
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-BOOLEAN-PARAM-VALUE>
              <SHORT-NAME>SpiEnableCs</SHORT-NAME>
              <VALUE>True</VALUE>
            </ECUC-BOOLEAN-PARAM-VALUE><ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiHwUnit</SHORT-NAME>
              <VALUE>CSIB0</VALUE>
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-TEXTUAL-PARAM-VALUE>
              <SHORT-NAME>SpiShiftClockIdleLevel</SHORT-NAME>
              <VALUE>HIGH</VALUE>
            </ECUC-TEXTUAL-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiTimeClk2Cs</SHORT-NAME>
              <VALUE>10</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiTimeCs2Clk</SHORT-NAME>
              <VALUE>10</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE><ECUC-NUMERICAL-PARAM-VALUE>
              <SHORT-NAME>SpiTimeCs2Cs</SHORT-NAME>
              <VALUE>10</VALUE>
            </ECUC-NUMERICAL-PARAM-VALUE>
          </PARAMETER-VALUES>
        </ECUC-CONTAINER-VALUE><ECUC-CONTAINER-VALUE>
          <SHORT-NAME>SpiDriver</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Spi/SpiDriver</DEFINITION-REF>
